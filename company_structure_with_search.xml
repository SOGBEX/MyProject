<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script type="text/javascript">
// Глобальные переменные для поиска
let globalHierarchy = {};
let searchableItems = [];

async function getEmployeeData() {
const soapEnvelope = 
'<soap:Envelope xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ' +
'xmlns:xsd="http://www.w3.org/2001/XMLSchema" ' +
'xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">' +
'<soap:Body>' +
'<GetListItems xmlns="http://schemas.microsoft.com/sharepoint/soap/">' +
'<listName>Сотрудники СМ</listName>' +
'<query><Query></Query></query>' +
'<viewFields><ViewFields>' +
'<FieldRef Name="ID"/>' +
'<FieldRef Name="LinkTitle"/>' +
'<FieldRef Name="_Photo"/>' +
'</ViewFields></viewFields>' +
'<rowLimit>500</rowLimit>' +
'</GetListItems>' +
'</soap:Body>' +
'</soap:Envelope>';

try {
const response = await fetch("/_vti_bin/Lists.asmx", {
method: "POST",
headers: {
"Content-Type": "text/xml; charset=utf-8",
"SOAPAction": "http://schemas.microsoft.com/sharepoint/soap/GetListItems"
},
body: soapEnvelope
});

if (!response.ok) {
throw new Error(`HTTP error! status: ${response.status}`);
}

const data = await response.text();
return parseEmployeeData(data);
} catch (error) {
console.error("Error retrieving employee data: ", error);
}
}

function parseEmployeeData(data) {
const parser = new DOMParser();
const xmlDoc = parser.parseFromString(data, "text/xml");
const items = xmlDoc.getElementsByTagName("z:row");
const employeeLinks = {};

for (let i = 0; i < items.length; i++) {
const linkTitle = items[i].getAttribute("ows_LinkTitle");
const itemId = items[i].getAttribute("ows_ID");
const photoUrl = items[i].getAttribute("ows__Photo");

console.log(`LinkTitle: ${linkTitle}, ItemId: ${itemId}, PhotoUrl: ${photoUrl}`);

if (linkTitle && itemId) {
employeeLinks[linkTitle] = {
link: `/Lists/Employees_synced/DispForm.aspx?ID=${itemId}`,
photo: photoUrl
};
}
}

console.log("Employee Links:", employeeLinks);
return employeeLinks;
}

async function getData() {
const employeeLinks = await getEmployeeData();

const soapEnvelope = 
'<soap:Envelope xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ' +
'xmlns:xsd="http://www.w3.org/2001/XMLSchema" ' +
'xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">' +
'<soap:Body>' +
'<GetListItems xmlns="http://schemas.microsoft.com/sharepoint/soap/">' +
'<listName>Структура компании</listName>' +
'<query><Query></Query></query>' +
'<viewFields><ViewFields>' +
'<FieldRef Name="ID"/>' +
'<FieldRef Name="LinkTitle"/>' +
'<FieldRef Name="Manager_x0020__x0028_yes_x002f_n"/>' +
'<FieldRef Name="Directorate"/>' +
'<FieldRef Name="Division"/>' +
'<FieldRef Name="Department"/>' +
'</ViewFields></viewFields>' +
'<rowLimit>500</rowLimit>' +
'</GetListItems>' +
'</soap:Body>' +
'</soap:Envelope>';

try {
const response = await fetch("/_vti_bin/Lists.asmx", {
method: "POST",
headers: {
"Content-Type": "text/xml; charset=utf-8",
"SOAPAction": "http://schemas.microsoft.com/sharepoint/soap/GetListItems"
},
body: soapEnvelope
});

if (!response.ok) {
throw new Error(`HTTP error! status: ${response.status}`);
}

const data = await response.text();
displayData(data, employeeLinks);
} catch (error) {
console.error("Error retrieving data: ", error);
}
}

function displayData(data, employeeLinks) {
const parser = new DOMParser();
const xmlDoc = parser.parseFromString(data, "text/xml");
const items = xmlDoc.getElementsByTagName("z:row");
const container = document.getElementById('treeContainer');
const hierarchy = {};

for (let i = 0; i < items.length; i++) {
const linkTitle = items[i].getAttribute("ows_LinkTitle");
const itemId = items[i].getAttribute("ows_ID");
const isManager = items[i].getAttribute("ows_Manager_x0020__x0028_yes_x002f_n");
const directorate = items[i].getAttribute("ows_Directorate");
const division = items[i].getAttribute("ows_Division");
const department = items[i].getAttribute("ows_Department");

if (!directorate && !division && !department) {
continue;
}

if (linkTitle) {
if (!hierarchy[directorate]) {
hierarchy[directorate] = { divisions: {}, employees: [] };
}

if (division && division !== "null") {
if (!hierarchy[directorate].divisions[division]) {
hierarchy[directorate].divisions[division] = { departments: {}, employees: [] };
}

if (department && department !== "null") {
if (!hierarchy[directorate].divisions[division].departments[department]) {
hierarchy[directorate].divisions[division].departments[department] = [];
}

if (employeeLinks[linkTitle]) {
hierarchy[directorate].divisions[division].departments[department].push({
name: linkTitle,
id: itemId,
link: employeeLinks[linkTitle].link,
isManager,
photo: employeeLinks[linkTitle].photo
});
} else {
console.warn(`Employee link not found for: ${linkTitle}`);
}
} else {
if (employeeLinks[linkTitle]) {
hierarchy[directorate].divisions[division].employees.push({
name: linkTitle,
id: itemId,
link: employeeLinks[linkTitle].link,
isManager,
photo: employeeLinks[linkTitle].photo
});
} else {
console.warn(`Employee link not found for: ${linkTitle}`);
}
}
} else {
if (employeeLinks[linkTitle]) {
hierarchy[directorate].employees.push({
name: linkTitle,
id: itemId,
link: employeeLinks[linkTitle].link,
isManager,
photo: employeeLinks[linkTitle].photo
});
} else {
console.warn(`Employee link not found for: ${linkTitle}`);
}
}
}
}

const sortedHierarchy = {};
const directoratesOrder = ["Техническая дирекция", "Управление", "Финансовая дирекция", "Дирекция трансформации и развитию бизнеса", "Коммерческая дирекция"];
directoratesOrder.forEach(directorate => {
if (hierarchy[directorate]) {
sortedHierarchy[directorate] = hierarchy[directorate];
}
});

// Сохраняем иерархию глобально для поиска
globalHierarchy = sortedHierarchy;
buildSearchableItems();
initializeSearch();

createTree(sortedHierarchy, container, employeeLinks);
}

// Функция для построения списка элементов для поиска
function buildSearchableItems() {
searchableItems = [];

for (const directorate in globalHierarchy) {
// Добавляем дирекцию
searchableItems.push({
name: directorate,
type: 'directorate',
path: [directorate]
});

// Добавляем департаменты
for (const division in globalHierarchy[directorate].divisions) {
searchableItems.push({
name: division,
type: 'division',
path: [directorate, division]
});

// Добавляем отделы
for (const department in globalHierarchy[directorate].divisions[division].departments) {
searchableItems.push({
name: department,
type: 'department',
path: [directorate, division, department]
});
}
}
}
}

// Инициализация поиска
function initializeSearch() {
const searchInput = document.getElementById('searchInput');
const searchDropdown = document.getElementById('searchDropdown');

searchInput.addEventListener('input', function() {
const query = this.value.toLowerCase().trim();

if (query.length === 0) {
// Показываем все элементы при пустом запросе
displaySearchResults(searchableItems);
searchDropdown.style.display = 'block';
return;
}

const filteredItems = searchableItems.filter(item => 
item.name.toLowerCase().includes(query)
);

if (filteredItems.length > 0) {
displaySearchResults(filteredItems);
searchDropdown.style.display = 'block';
} else {
searchDropdown.style.display = 'none';
}
});

// Показываем выпадающий список при фокусе
searchInput.addEventListener('focus', function() {
const query = this.value.toLowerCase().trim();
if (query.length === 0) {
// Показываем все элементы при пустом поле
displaySearchResults(searchableItems);
} else {
// Показываем отфильтрованные элементы
const filteredItems = searchableItems.filter(item => 
item.name.toLowerCase().includes(query)
);
if (filteredItems.length > 0) {
displaySearchResults(filteredItems);
}
}
searchDropdown.style.display = 'block';
});

// Скрываем выпадающий список при клике вне его
document.addEventListener('click', function(event) {
if (!event.target.closest('#searchWrapper')) {
searchDropdown.style.display = 'none';
}
});
}

// Отображение результатов поиска
function displaySearchResults(items) {
const dropdown = document.getElementById('searchDropdown');
dropdown.innerHTML = '';

items.forEach(item => {
const div = document.createElement('div');
div.className = 'search-result-item';
div.textContent = item.name;
div.setAttribute('data-type', item.type);
div.setAttribute('data-path', JSON.stringify(item.path));

div.addEventListener('click', function() {
navigateToItem(item);
dropdown.style.display = 'none';
document.getElementById('searchInput').value = '';
});

dropdown.appendChild(div);
});
}

// Навигация к выбранному элементу
function navigateToItem(item) {
console.log('Navigating to item:', item); // Отладочная информация

// Сначала закрываем все открытые блоки
$('.block.division > .division-inner-container > ul').hide();
$('.block.division').removeClass('open');
$('.block.department > .department-inner-container > ul').hide();
$('.block.department').removeClass('open');

const [directorate, division, department] = item.path;
console.log('Path:', directorate, division, department); // Отладочная информация

if (item.type === 'division' && division) {
// Находим и открываем департамент
const divisionBlocks = $('.block.division').filter(function() {
const titleText = $(this).children('span').first().text().trim();
console.log('Checking division:', titleText, 'against:', division);
return titleText === division;
});

console.log('Found division blocks:', divisionBlocks.length);

if (divisionBlocks.length > 0) {
const divisionBlock = divisionBlocks.first();
const divisionUl = divisionBlock.find('.division-inner-container > ul');
divisionUl.show();
divisionBlock.addClass('open');
// Прокручиваем к элементу
divisionBlock[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
console.log('Division opened successfully');
}
} else if (item.type === 'department' && department) {
// Находим и открываем департамент, затем отдел
const divisionBlocks = $('.block.division').filter(function() {
const titleText = $(this).children('span').first().text().trim();
return titleText === division;
});

console.log('Found division blocks for department:', divisionBlocks.length);

if (divisionBlocks.length > 0) {
const divisionBlock = divisionBlocks.first();
const divisionUl = divisionBlock.find('.division-inner-container > ul');
divisionUl.show();
divisionBlock.addClass('open');

// Находим и открываем отдел
setTimeout(() => {
const departmentBlocks = divisionBlock.find('.block.department').filter(function() {
// Получаем только первый текстовый узел (название отдела)
const titleText = $(this).contents().filter(function() {
return this.nodeType === 3; // текстовый узел
}).text().trim();
console.log('Checking department:', titleText, 'against:', department);
return titleText === department;
});

console.log('Found department blocks:', departmentBlocks.length);

if (departmentBlocks.length > 0) {
const departmentBlock = departmentBlocks.first();
const departmentUl = departmentBlock.find('.department-inner-container > ul');
departmentUl.show();
departmentBlock.addClass('open');
// Прокручиваем к элементу
departmentBlock[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
console.log('Department opened successfully');
}
}, 200);
}
} else if (item.type === 'directorate') {
// Прокручиваем к дирекции
const directorateBlocks = $('.block.directorate').filter(function() {
const titleText = $(this).find('span').first().text().trim();
console.log('Checking directorate:', titleText, 'against:', directorate);
return titleText === directorate;
});

console.log('Found directorate blocks:', directorateBlocks.length);

if (directorateBlocks.length > 0) {
const directorateBlock = directorateBlocks.first();
directorateBlock[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
console.log('Directorate scrolled to successfully');
}
}
}

function createTree(hierarchy, parentContainer, employeeLinks) {
if (!parentContainer) {
console.error("Parent container is null. Check if the element exists in the DOM.");
return;
}

const directorateUl = document.createElement('ul');
parentContainer.appendChild(directorateUl);

for (const directorate in hierarchy) {
const directorateLi = document.createElement('li');
directorateLi.className = 'block directorate';

const directorateTitle = document.createElement('span');
directorateTitle.textContent = directorate;
directorateTitle.style.textAlign = 'center';
directorateTitle.style.color = '#FFFFFF';
directorateTitle.style.fontWeight = 'bold';
directorateLi.appendChild(directorateTitle);

const innerContainer = document.createElement('div');
innerContainer.className = 'inner-container';
directorateLi.appendChild(innerContainer);

const innerUl = document.createElement('ul');
innerContainer.appendChild(innerUl);
directorateUl.appendChild(directorateLi);

const managers = hierarchy[directorate].employees.filter(emp => emp.isManager === "1");
const otherEmployees = hierarchy[directorate].employees.filter(emp => emp.isManager !== "1");
const sortedEmployees = [...managers, ...otherEmployees];

sortedEmployees.forEach(employee => {
const nameLi = document.createElement('li');
const link = document.createElement('a');
link.textContent = employee.name;
link.href = employee.link;
link.target = '_blank';

if (employee.name === "Урьев Григорий Анатольевич") {
link.innerHTML = `<strong>${employee.name} 🤴🏻</strong>`;
} else if (employee.isManager === "1") {
link.innerHTML = `<strong>${employee.name} 👑</strong>`;
} else {
link.textContent = employee.name;
}

link.addEventListener('mouseover', () => {
const tooltip = document.getElementById('photoTooltip');
const tooltipImage = document.getElementById('tooltipImage');
tooltipImage.src = employee.photo.split(',')[0];
tooltip.style.display = 'block';

// Получаем координаты с учетом прокрутки
const rect = link.getBoundingClientRect();
const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
const scrollLeft = window.pageXOffset || document.documentElement.scrollLeft;

// Базовые координаты
let left = rect.left + scrollLeft;
let top = rect.bottom + scrollTop + 5;

// Проверяем, не выходит ли tooltip за правую границу экрана
const tooltipWidth = 200; // примерная ширина tooltip
if (left + tooltipWidth > window.innerWidth + scrollLeft) {
left = rect.right + scrollLeft - tooltipWidth;
}

// Проверяем, не выходит ли tooltip за нижнюю границу экрана
const tooltipHeight = 170; // примерная высота tooltip (160px изображение + отступы)
if (top + tooltipHeight > window.innerHeight + scrollTop) {
top = rect.top + scrollTop - tooltipHeight - 5; // показываем сверху
}

tooltip.style.left = `${Math.max(0, left)}px`;
tooltip.style.top = `${Math.max(0, top)}px`;
});

link.addEventListener('mouseout', () => {
const tooltip = document.getElementById('photoTooltip');
tooltip.style.display = 'none';
});

nameLi.appendChild(link);
nameLi.style.margin = '0';
nameLi.style.textAlign = 'left';
nameLi.style.listStyleType = 'none';
innerUl.appendChild(nameLi);
});

for (const division in hierarchy[directorate].divisions) {
const divisionLi = document.createElement('li');
divisionLi.className = 'block division';

const divisionTitle = document.createElement('span');
divisionTitle.textContent = division;
divisionTitle.style.cursor = 'pointer';
divisionTitle.style.color = '#FFFFFF';
divisionTitle.style.fontWeight = 'bold';
divisionLi.appendChild(divisionTitle);

const divisionInnerContainer = document.createElement('div');
divisionInnerContainer.className = 'division-inner-container';
divisionLi.appendChild(divisionInnerContainer);

const divisionUl = document.createElement('ul');
divisionInnerContainer.appendChild(divisionUl);
innerUl.appendChild(divisionLi);

divisionUl.style.display = 'none';

const divisionEmployees = hierarchy[directorate].divisions[division].employees;
const divisionManagers = divisionEmployees.filter(emp => emp.isManager === "1");
const divisionOtherEmployees = divisionEmployees.filter(emp => emp.isManager !== "1");
const sortedDivisionEmployees = [...divisionManagers, ...divisionOtherEmployees];

sortedDivisionEmployees.forEach(employee => {
const nameLi = document.createElement('li');
const link = document.createElement('a');
link.textContent = employee.name;
link.href = employee.link;
link.target = '_blank';

if (employee.isManager === "1") {
link.innerHTML = `<strong>${employee.name} 👑</strong>`;
}

link.addEventListener('mouseover', () => {
const tooltip = document.getElementById('photoTooltip');
const tooltipImage = document.getElementById('tooltipImage');
tooltipImage.src = employee.photo.split(',')[0];
tooltip.style.display = 'block';

// Получаем координаты с учетом прокрутки
const rect = link.getBoundingClientRect();
const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
const scrollLeft = window.pageXOffset || document.documentElement.scrollLeft;

// Базовые координаты
let left = rect.left + scrollLeft;
let top = rect.bottom + scrollTop + 5;

// Проверяем, не выходит ли tooltip за правую границу экрана
const tooltipWidth = 200; // примерная ширина tooltip
if (left + tooltipWidth > window.innerWidth + scrollLeft) {
left = rect.right + scrollLeft - tooltipWidth;
}

// Проверяем, не выходит ли tooltip за нижнюю границу экрана
const tooltipHeight = 170; // примерная высота tooltip (160px изображение + отступы)
if (top + tooltipHeight > window.innerHeight + scrollTop) {
top = rect.top + scrollTop - tooltipHeight - 5; // показываем сверху
}

tooltip.style.left = `${Math.max(0, left)}px`;
tooltip.style.top = `${Math.max(0, top)}px`;
});

link.addEventListener('mouseout', () => {
const tooltip = document.getElementById('photoTooltip');
tooltip.style.display = 'none';
});

nameLi.appendChild(link);
nameLi.style.margin = '0';
nameLi.style.textAlign = 'left';
nameLi.style.listStyleType = 'none';
divisionUl.appendChild(nameLi);
});

for (const department in hierarchy[directorate].divisions[division].departments) {
const departmentLi = document.createElement('li');
departmentLi.className = 'block department';
departmentLi.textContent = department;
departmentLi.style.fontWeight = 'bold';
departmentLi.style.color = '#FFFFFF';

const departmentInnerContainer = document.createElement('div');
departmentInnerContainer.className = 'department-inner-container';
departmentLi.appendChild(departmentInnerContainer);

const departmentUl = document.createElement('ul');
departmentInnerContainer.appendChild(departmentUl);
divisionUl.appendChild(departmentLi);

departmentUl.style.display = 'none';

const departmentEmployees = hierarchy[directorate].divisions[division].departments[department];
const departmentManagers = departmentEmployees.filter(emp => emp.isManager === "1");
const departmentOtherEmployees = departmentEmployees.filter(emp => emp.isManager !== "1");
const sortedDepartmentEmployees = [...departmentManagers, ...departmentOtherEmployees];

sortedDepartmentEmployees.forEach(employee => {
const nameLi = document.createElement('li');
const link = document.createElement('a');
link.textContent = employee.name;
link.href = employee.link;
link.target = '_blank';

if (employee.isManager === "1") {
link.innerHTML = `<strong>${employee.name} 👑</strong>`;
}

link.addEventListener('mouseover', () => {
const tooltip = document.getElementById('photoTooltip');
const tooltipImage = document.getElementById('tooltipImage');
tooltipImage.src = employee.photo.split(',')[0];
tooltip.style.display = 'block';

// Получаем координаты с учетом прокрутки
const rect = link.getBoundingClientRect();
const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
const scrollLeft = window.pageXOffset || document.documentElement.scrollLeft;

// Базовые координаты
let left = rect.left + scrollLeft;
let top = rect.bottom + scrollTop + 5;

// Проверяем, не выходит ли tooltip за правую границу экрана
const tooltipWidth = 200; // примерная ширина tooltip
if (left + tooltipWidth > window.innerWidth + scrollLeft) {
left = rect.right + scrollLeft - tooltipWidth;
}

// Проверяем, не выходит ли tooltip за нижнюю границу экрана
const tooltipHeight = 170; // примерная высота tooltip (160px изображение + отступы)
if (top + tooltipHeight > window.innerHeight + scrollTop) {
top = rect.top + scrollTop - tooltipHeight - 5; // показываем сверху
}

tooltip.style.left = `${Math.max(0, left)}px`;
tooltip.style.top = `${Math.max(0, top)}px`;
});

link.addEventListener('mouseout', () => {
const tooltip = document.getElementById('photoTooltip');
tooltip.style.display = 'none';
});

nameLi.appendChild(link);
nameLi.style.margin = '0';
nameLi.style.textAlign = 'left';
nameLi.style.listStyleType = 'none';
nameLi.style.fontWeight = 'normal';
departmentUl.appendChild(nameLi);
});
}
}
}
}

$(document).ready(function() {
getData();
});

$(document).on('click', '.block.division', function(e) {
if ($(e.target).closest('.division-inner-container').length === 0) {
const divisionUl = $(this).find('.division-inner-container > ul');
$('.block.division > .division-inner-container > ul').not(divisionUl).hide();
$('.block.division').not(this).removeClass('open');

divisionUl.toggle();
$(this).toggleClass('open');
e.stopPropagation();
}
});

$(document).on('click', '.block.department', function(e) {
if ($(e.target).closest('.department-inner-container').length === 0) {
const departmentUl = $(this).find('.department-inner-container > ul');
$('.block.department > .department-inner-container > ul').not(departmentUl).hide();
$('.block.department').not(this).removeClass('open');

departmentUl.toggle();
$(this).toggleClass('open');
e.stopPropagation();
}
});
