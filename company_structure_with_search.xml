.block {
display: block;
padding: 10px;
margin: 5px 0;
border: 2px solid #FFDF94;
border-radius: 5px;
cursor: pointer;
transition: background-color 0.3s;
}
.block.directorate {
display: inline-block;
width: 500px;
vertical-align: top;
margin-right: 10px;
background-color: #002C84;
text-align: center;
cursor: default;
}

.block.directorate:hover {
background-color: #011a59;
}   

.block.division {
background-color: #573f8f;
}

.block.division:hover {
background-color: #3d235c;
}

.block.department {
background-color: #4862c2;
}

.block.department:hover {
background-color: #2f4699;
}
.inner-container {
background-color: #ffffff;
padding: 10px;
border: 1px solid #FFDF94;
border-radius: 5px;
margin-top: 5px;
cursor: default;
}
.division-inner-container {
background-color: #ffffff;
padding: 10px;
border: 1px solid #FFDF94;
border-radius: 5px;
margin-top: 5px;
cursor: default;
}
.department-inner-container {
background-color: #ffffff;
padding: 10px;
border: 1px solid #FFDF94;
border-radius: 5px;
margin-top: 5px;
cursor: default;
}
.block.division:not(.open) > .division-inner-container {
display: none;
}
.block.department:not(.open) > .department-inner-container {
display: none;
}

#photoTooltip {
position: absolute;
z-index: 1000;
background-color: #ffffff;
border: 1px solid #011a59;
border-radius: 10px;
padding: 5px;
pointer-events: none;
box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
max-width: 200px;
}

/* Стили для поиска */
#searchWrapper {
position: relative;
}

#searchInput {
width: 100%;
padding: 10px;
border: 2px solid #FFDF94;
border-radius: 5px;
font-size: 12px;
box-sizing: border-box;
outline: none;
}

#searchInput:focus {
border-color: #002C84;
box-shadow: 0 0 5px rgba(0, 44, 132, 0.3);
}

#searchDropdown {
position: absolute;
top: 100%;
left: 0;
right: 0;
background: white;
border: 2px solid #FFDF94;
border-top: none;
border-radius: 0 0 5px 5px;
max-height: 300px;
overflow-y: auto;
z-index: 1001;
box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.search-result-item {
padding: 10px 15px;
cursor: pointer;
border-bottom: 1px solid #f0f0f0;
transition: background-color 0.2s;
}

.search-result-item:hover {
background-color: #f8f9fa;
}

.search-result-item:last-child {
border-bottom: none;
}

.search-result-item[data-type="directorate"] {
font-weight: bold;
color: #002C84;
}

.search-result-item[data-type="division"] {
color: #573f8f;
padding-left: 25px;
}

.search-result-item[data-type="department"] {
color: #4862c2;
padding-left: 35px;
}
</style>
]]></Content>
